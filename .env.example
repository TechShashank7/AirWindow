# Google Maps JavaScript API Key
# Set this variable in local .env or .env.local, or in your hosting environment (e.g. AWS Amplify)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API Gateway URL for evaluation and live observations
VITE_EVALUATE_API_URL=https://your-api-gateway-url.execute-api.ap-southeast-2.amazonaws.com
